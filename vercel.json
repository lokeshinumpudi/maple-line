{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build:public",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/game/dist-public",
  "rewrites": [
    { "source": "/maple-line/", "destination": "/index.html" },
    { "source": "/maple-line", "destination": "/index.html" },
    { "source": "/maple-line/:path*", "destination": "/:path*" }
  ]
}
