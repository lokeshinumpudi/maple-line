{
  "name": "@maple-line/director",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../../.env src/server.js",
    "test": "node --test tests/*.test.js",
    "lint": "oxlint --deny-warnings src tests",
    "format": "prettier --ignore-path ../../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../../.prettierignore --check .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@maple-line/world-spec": "workspace:*",
    "ai": "7.0.107",
    "@maple-line/voice-score": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  }
}
